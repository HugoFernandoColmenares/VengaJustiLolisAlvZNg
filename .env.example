# Copia este archivo a .env y completa los valores de la app web de Firebase.
# .env no se sube al repo. No commitees src/environments/environment.ts después de `npm run env:local`.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
